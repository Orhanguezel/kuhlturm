# =========================================================
# Kuhlturm Admin Panel — Environment variables
# =========================================================

# Locale — kuhlturm DE + EN destekler
NEXT_PUBLIC_DEFAULT_LOCALE=de
NEXT_PUBLIC_APP_ENV=kuhlturm_admin

# =========================================================
# Backend API URL (kuhlturm-backend, port 8089)
# =========================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8089/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8089/api
PANEL_API_URL=http://127.0.0.1:8089

# =========================================================
# Site URL'leri
# =========================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3023
NEXT_PUBLIC_REVALIDATE_TARGETS=https://kuhlturm.com
NEXT_PUBLIC_CORS_ORIGINS=http://localhost:3000,http://localhost:3023,https://kuhlturm.com,https://kuhlturm.com

# =========================================================
# Analytics / captcha (opsiyonel)
# =========================================================
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GA_ID=
