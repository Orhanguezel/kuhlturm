# =========================================================
# Kuhlturm Backend — Environment variables
# =========================================================
PORT=8089
NODE_ENV=development
HOST=127.0.0.1

# =========================================================
# DB — kuhlturm kendi veritabanına sahip
# =========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app
DB_NAME=kuhlturm

# =========================================================
# Auth
# =========================================================
JWT_SECRET=change-me-long-random-jwt-secret
COOKIE_SECRET=change-me-long-random-cookie-secret
AUTH_ADMIN_EMAILS=admin@example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# =========================================================
# CORS
# =========================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3023,http://127.0.0.1:3000,http://127.0.0.1:3023,https://kuhlturm.com,https://kuhlturm.com

# =========================================================
# Storage / Upload
# =========================================================
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/uploads
LOCAL_STORAGE_BASE_URL=/uploads
STORAGE_PUBLIC_API_BASE=http://localhost:8089

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kuhlturm

# =========================================================
# Mail / SMTP
# =========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=no-reply@kuhlturm.com

# =========================================================
# URL'ler
# =========================================================
PUBLIC_URL=http://localhost:8089
FRONTEND_URL=https://kuhlturm.com
PUBLIC_API_BASE=https://kuhlturm.com/api

# =========================================================
# Locale — kuhlturm DE + EN destekler (TR yok)
# =========================================================
DEFAULT_LOCALE=de
SUPPORTED_LOCALES=de,en

# =========================================================
# Google OAuth (opsiyonel)
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Read-only Tanitio website content API; use a unique random secret per site.
TANITIO_CONTENT_API_KEY=

# Public registration must never grant an administrative role.
AUTH_PUBLIC_SIGNUP_ROLE=user
